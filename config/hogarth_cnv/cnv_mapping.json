{
  "schema_version": 1,
  "identity": {
    "filename_pattern": "^(?P<cruise>[^_]+)_Stn\\.(?P<station>.+)_(?P<sequence>\\d+)_DatCnv_processed\\.cnv$",
    "cruise_case": "upper",
    "station_case": "upper",
    "normalize_numeric_station": true
  },
  "structural_fields": {
    "depth": {
      "source_candidates": ["depSM"],
      "required": true,
      "transform": {"type": "identity"},
      "units": "m"
    },
    "time": {
      "source_candidates": ["timeQ"],
      "required": true,
      "transform": {
        "type": "epoch_offset",
        "offset_seconds": 946684800
      },
      "units": "seconds since 1970-01-01T00:00:00Z",
      "calendar": "gregorian"
    },
    "latitude": {
      "source_candidates": ["latitude"],
      "required": true,
      "transform": {"type": "identity"},
      "reducer": "median",
      "units": "degrees_north",
      "retain_samples_as": "latitude_sample"
    },
    "longitude": {
      "source_candidates": ["longitude"],
      "required": true,
      "transform": {"type": "identity"},
      "reducer": "median",
      "units": "degrees_east",
      "retain_samples_as": "longitude_sample"
    }
  },
  "science_variables": {
    "scan": {"target": "scan"},
    "c0S/m": {
      "target": "sea_water_electrical_conductivity"
    },
    "t090C": {"target": "sea_water_temperature"},
    "sal00": {"target": "sea_water_salinity"},
    "oxsatMg/L": {"target": "oxygen_saturation_2"},
    "sbeox0Mg/L": {"target": "dissolved_oxygen"},
    "flECO-AFL": {
      "target": "chlorophyll_concentration"
    },
    "wetCDOM": {"target": "CDOM"},
    "turbWETntu0": {"target": "sea_water_turbidity"},
    "density00": {"target": "sea_water_density"},
    "svCM": {"target": "sound_velocity"},
    "oxsolMg/L": {"target": "oxygen_saturation"},
    "timeS": {"target": "time_elapsed"},
    "timeM": {"target": "seabird_elapsed_minutes"},
    "timeH": {"target": "seabird_elapsed_hours"},
    "timeJ": {"target": "seabird_julian_day"},
    "altM": {"target": "altimeter"},
    "flag": {"target": "flag"}
  }
}
