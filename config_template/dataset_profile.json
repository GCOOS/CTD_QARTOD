{
  "data_root": "datasets/YOUR_DATASET_ROOT",
  "output": {
    "mode": "duplicate",
    "directory": "output"
  },
  "metadata": {
    "station": "station",
    "cruise_id": "cruiseID",
    "longitude": ["longitude", "lon"],
    "latitude": ["latitude", "lat"],
    "depth": ["depth"],
    "time": ["time"],
    "sample_dimension": "z"
  },
  "qc_test_modes": {
    "gap_test": "not_evaluated",
    "syntax_test": "not_evaluated"
  },
  "erddap": {
    "output_xml": "output/erddap/datasets.xml",
    "filedir_prefix": "/data/erddap/YOUR_DATASET",
    "dataset_id_prefix": "",
    "required_global_attributes": [
      "title",
      "summary",
      "institution",
      "publisher_name",
      "publisher_email",
      "license"
    ],
    "global_add_attributes": {}
  },
  "paths": {
    "cnv_mapping": "config/YOUR_DATASET/cnv_mapping.json",
    "variable_mapping": "config/YOUR_DATASET/qc_variable_mapping.json",
    "station_coords": "config/YOUR_DATASET/location_test/Station_Mean_Coords.csv",
    "location_config": "config/YOUR_DATASET/location_test/location_config.json",
    "station_climatology": "config/YOUR_DATASET/climatology_test/station_climatology_config.json",
    "station_depth_classification": "config/YOUR_DATASET/climatology_test/station_depth_classification.json",
    "sensor_specs": "config/YOUR_DATASET/gross_range_test/sensor_specs.json",
    "variable_sensor_map": "config/YOUR_DATASET/gross_range_test/variable_sensor_map.json",
    "spike_thresholds": "config/YOUR_DATASET/spike_test/spike_thresholds.json",
    "rate_of_change_thresholds": "config/YOUR_DATASET/rate_of_change_test/rate_of_change_thresholds.json",
    "flat_line_config": "config/YOUR_DATASET/flat_line_test/flat_line_config.json"
  }
}
